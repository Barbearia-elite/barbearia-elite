# ============================================================
# Barbearia Elite — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca envie o .env para o repositório (já está no .gitignore).
# ============================================================

# ---------- Banco de dados (Supabase) ----------
# URL do projeto (Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
# Service Role Key — APENAS no servidor. Nunca expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=troque-pela-service-role-key

# ---------- Frontend (Vite) ----------
# As variáveis VITE_* são embutidas no bundle no momento do build.
# Use a anon/publishable key (pública) aqui.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=troque-pela-anon-key-publica

# ---------- Autorização do servidor ----------
# Chave usada para assinar a sessão admin (HMAC-SHA256). Use algo longo e aleatório.
SESSION_SECRET=troque-por-uma-frase-aleatoria-longa-e-secreta

# Tokens de acesso dos barbeiros (login no Portal Admin).
# Use valores longos e secretos — não reutilize os exemplos abaixo.
JOAO_TOKEN=troque-por-um-token-forte-do-joao
CRISTIAN_TOKEN=troque-por-um-token-forte-do-cristian

# ---------- Não obrigatório ----------
# NODE_ENV=development | production  (controla cookie seguro em produção)
# PORT=3000